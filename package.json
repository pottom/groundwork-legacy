{
  "name": "@pottom/groundwork",
  "version": "0.1.0",
  "description": "From idea to delivery: a live mind map that writes product docs, and a development dashboard, on one local server.",
  "type": "module",
  "license": "MIT",
  "bin": { "groundwork": "core/groundwork.mjs" },
  "files": ["core/", "modules/", "!**/*.test*.mjs"],
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node core/groundwork.mjs",
    "test": "node --test \"core/**/*.test.mjs\" \"modules/**/*.test.mjs\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": { "@types/node": "20.19.43", "typescript": "5.9.3" }
}
